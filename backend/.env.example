# V.E.R.A. AI Environment Variables
# Copy to .env and fill in values when ready

# AI Provider (OpenAI, OpenRouter, Groq, or any OpenAI-compatible API)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Optional Google Gemini API Key
GEMINI_API_KEY=

# GitHub Personal Access Token (Optional: raises API rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# Operator Configuration
OPERATOR_NAME=Prathmesh Mante
GITHUB_USERNAME=prathmeshmante-glitch
VERA_PASSPHRASE=Open the command deck

# Server Configuration
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=*
SESSION_SECRET=vera-super-secret-production-key-change-me
